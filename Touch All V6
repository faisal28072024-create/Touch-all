		GetTargets(),
		Token
	)

end

--============================================================
-- RUN MODE
--============================================================

local function RunPass(
	Token
)

	if CONFIG.Mode ==
		"Normal" then

		RunNormal(
			GetTargets(),
			Token
		)

	elseif CONFIG.Mode ==
		"Lock" then

		RunLock(
			Token
		)

	elseif CONFIG.Mode ==
		"Random" then

		RunRandom(
			GetTargets(),
			Token
		)

	elseif CONFIG.Mode ==
		"Nearest" then

		RunNearest(
			Token
		)

	elseif CONFIG.Mode ==
		"Cycle" then

		RunCycle(
			Token
		)

	elseif CONFIG.Mode ==
		"Hunter" then

		RunHunter(
			Token
		)

	elseif CONFIG.Mode ==
		"Ping-Pong" then

		RunPingPong(
			Token
		)

	elseif CONFIG.Mode ==
		"Survivor" then

		RunSurvivor(
			Token
		)

	elseif CONFIG.Mode ==
		"Last" then

		RunLast(
			Token
		)

	end

end

--============================================================
-- TL
--============================================================

local function RunTL()

	if Running then
		return
	end

	ActionToken += 1

	local Token =
		ActionToken

	Running = true
	LoopMode = false

	LastTarget = nil

	SaveStartPosition()

	Status.Text =
		"TL • " ..
		string.upper(
			CONFIG.Mode
		)

	RunPass(
		Token
	)

	if Running
		and Token == ActionToken then

		ReturnToStart()

	end

	if Token ==
		ActionToken then

		Running = false

	end

	StartCFrame = nil

	if not Running then

		Status.Text =
			"FINISHED"

	end

end

--============================================================
-- LTL
--============================================================

local function RunLTL()

	if Running then
		return
	end

	ActionToken += 1

	local Token =
		ActionToken

	Running = true
	LoopMode = true

	LastTarget = nil

	PingPongForward = true

	SaveStartPosition()

	Status.Text =
		"LTL • " ..
		string.upper(
			CONFIG.Mode
		)

	while Running
		and LoopMode
		and Token == ActionToken do

		RunPass(
			Token
		)

		if not Running
			or Token ~= ActionToken then

			break

		end

		task.wait()

	end

	if Token ==
		ActionToken then

		ReturnToStart()

		Running = false
		LoopMode = false

	end

	StartCFrame = nil

	Status.Text =
		"LTL STOPPED"

end

--============================================================
-- STOP FORCE
--============================================================

local function StopForce()

	-- Invalidate seluruh loop lama
	ActionToken += 1

	-- Matikan state
	Running = false
	LoopMode = false

	-- Kembalikan posisi
	ReturnToStart()

	-- Reset
	StartCFrame = nil
	LastTarget = nil

	Status.Text =
		"STOP FORCE"

end


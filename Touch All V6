end

--============================================================
-- LAST
--============================================================

local function RunLast(
	Token
)

	if LastTarget
		and IsValidTarget(
			LastTarget
		) then

		TeleportTo(
			LastTarget
		)

		TeleportDelay(
			Token
		)

		return

	end

	local Targets =
		GetTargets()

	if #Targets == 0 then
		return
	end

	local Target =
		Targets[1]

	if IsValidTarget(
		Target
	) then

		TeleportTo(
			Target
		)

		LastTarget =
			Target

		TeleportDelay(
			Token
		)

	end

end

--============================================================
-- CYCLE
--============================================================

local function RunCycle(
	Token
)


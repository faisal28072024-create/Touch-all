--============================================================
-- GET LOCAL ROOT
--============================================================

local function GetRoot()

	local Character =
		LocalPlayer.Character

	if not Character then
		return nil
	end

	return Character:FindFirstChild(
		"HumanoidRootPart"
	)

end

--============================================================
-- SAVE START
--============================================================

local function SaveStartPosition()

	local Root =
		GetRoot()

	if Root then

		StartCFrame =
			Root.CFrame

	else

		StartCFrame = nil

	end

end

--============================================================
-- RETURN
--============================================================

local function ReturnToStart()

	if not CONFIG.ReturnToStart then
		return
	end

	if not StartCFrame then
		return
	end

	local Root =
		GetRoot()

	if Root then

		Root.CFrame =
			StartCFrame

	end

end

--============================================================
-- TEAM CHECK
--============================================================

local function IsIgnoredTeam(Player)

	local Team =
		Player.Team

	if not Team then
		return false
	end

	return IgnoredTeams[Team] == true

end

--============================================================
-- TARGET VALIDATION
--============================================================

local function IsValidTarget(Player)

	if Player == LocalPlayer then
		return false
	end

	if not Player.Parent then
		return false
	end

	if IsIgnoredTeam(Player) then
		return false
	end

	local Character =
		Player.Character

	if not Character then
		return false
	end

	local Root =
		Character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not Root then
		return false
	end

	local Humanoid =
		Character:FindFirstChildOfClass(
			"Humanoid"
		)

	if Humanoid and
		Humanoid.Health <= 0 then

		return false

	end

	return true

end

--============================================================
-- TELEPORT
--============================================================

local function TeleportTo(Player)

	local Root =
		GetRoot()

	if not Root then
		return false
	end

	if not IsValidTarget(Player) then
		return false
	end

	local Character =
		Player.Character

	local TargetRoot =
		Character and
		Character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not TargetRoot then
		return false
	end

	--========================================================
	-- V6 FIX:
	-- Tepat di posisi target.
	-- Tidak lagi berada di depan target.
	--========================================================

	Root.CFrame =
		TargetRoot.CFrame *
		CONFIG.TargetOffset

	return true

end

--============================================================
-- GET TARGETS
--============================================================

local function GetTargets()

	local Targets = {}

	for _, Player in ipairs(
		Players:GetPlayers()
	) do

		if IsValidTarget(Player) then

			table.insert(
				Targets,
				Player
			)

		end

	end

	return Targets

end

--============================================================
-- DELAY
--============================================================

local function TeleportDelay()

	if CONFIG.TeleportDelay > 0 then

		task.wait(
			CONFIG.TeleportDelay
		)

	else

		task.wait()

	end

end

--============================================================
-- RANDOM SHUFFLE
--============================================================

local function Shuffle(Targets)

	for i = #Targets, 2, -1 do

		local j =
			math.random(1, i)

		Targets[i],
		Targets[j] =
			Targets[j],
			Targets[i]

	end

end

--============================================================
-- NEAREST
--============================================================

local function GetNearestTarget(Targets)

	local Root =
		GetRoot()

	if not Root then
		return nil
	end

	local Nearest = nil

	local NearestDistance =
		math.huge

	for _, Player in ipairs(Targets) do

		if IsValidTarget(Player) then

			local Character =
				Player.Character

			local TargetRoot =
				Character and
				Character:FindFirstChild(
					"HumanoidRootPart"
				)

			if TargetRoot then

				local Distance =
					(
						Root.Position -
						TargetRoot.Position
					).Magnitude

				if Distance <
					NearestDistance then

					NearestDistance =
						Distance

					Nearest =
						Player

				end

			end

		end

	end

	return Nearest

end

--============================================================
-- NORMAL
--============================================================

local function RunNormal(Targets)

	for _, Player in ipairs(Targets) do

		if not Running then
			break
		end

		if IsValidTarget(Player) then

			TeleportTo(Player)

			LastTarget =
				Player

			TeleportDelay()

		end

	end

end

--============================================================
-- RANDOM
--============================================================

local function RunRandom(Targets)

	Shuffle(Targets)

	for _, Player in ipairs(Targets) do

		if not Running then
			break
		end

		if IsValidTarget(Player) then

			TeleportTo(Player)

			LastTarget =
				Player

			TeleportDelay()

		end

	end

end

--============================================================
-- NEAREST
--============================================================

local function RunNearest()

	local Remaining =
		GetTargets()

	while Running and
		#Remaining > 0 do

		local Target =
			GetNearestTarget(
				Remaining
			)

		if not Target then
			break
		end

		if IsValidTarget(Target) then

			TeleportTo(Target)

			LastTarget =
				Target

			TeleportDelay()

		end

		for i, Player in ipairs(
			Remaining
		) do

			if Player == Target then

				table.remove(
					Remaining,
					i
				)

				break

			end

		end

	end

end

--============================================================
-- HUNTER
-- Target terjauh
--============================================================

local function GetFarthestTarget(
	Targets
)

	local Root =
		GetRoot()

	if not Root then
		return nil
	end

	local Farthest = nil

	local FarthestDistance =
		-1

	for _, Player in ipairs(
		Targets
	) do

		if IsValidTarget(Player) then

			local Character =
				Player.Character

			local TargetRoot =
				Character and
				Character:FindFirstChild(
					"HumanoidRootPart"
				)

			if TargetRoot then

				local Distance =
					(
						Root.Position -
						TargetRoot.Position
					).Magnitude

				if Distance >
					FarthestDistance then

					FarthestDistance =
						Distance

					Farthest =
						Player

				end

			end

		end

	end

	return Farthest

end

local function RunHunter()

	local Remaining =
		GetTargets()

	while Running and
		#Remaining > 0 do

		local Target =
			GetFarthestTarget(
				Remaining
			)

		if not Target then
			break
		end

		if IsValidTarget(Target) then

			TeleportTo(Target)

			LastTarget =
				Target

			TeleportDelay()

		end

		for i, Player in ipairs(
			Remaining
		) do

			if Player == Target then

				table.remove(
					Remaining,
					i
				)

				break

			end

		end

	end

end

--============================================================
-- PING-PONG
--============================================================

local function RunPingPong()

	local Targets =
		GetTargets()

	if #Targets == 0 then
		return
	end

	-- Urutkan berdasarkan nama
	table.sort(
		Targets,
		function(A, B)
			return A.Name < B.Name
		end
	)

	if PingPongForward then

		for i = 1, #Targets do

			if not Running then
				break
			end

			local Player =
				Targets[i]

			if IsValidTarget(Player) then

				TeleportTo(Player)

				LastTarget =
					Player

				TeleportDelay()

			end

		end

	else

		for i = #Targets, 1, -1 do

			if not Running then
				break
			end

			local Player =
				Targets[i]

			if IsValidTarget(Player) then

				TeleportTo(Player)

				LastTarget =
					Player

				TeleportDelay()

			end

		end

	end

	PingPongForward =
		not PingPongForward

end

--============================================================
-- LOCK
--============================================================

local function RunLockTarget(
	Player
)

	if not Player then
		return
	end

	local LockedCharacter =
		Player.Character

	if not LockedCharacter then
		return
	end

	Status.Text =
		"LOCK: " ..
		Player.Name

	while Running do

		-- Player keluar
		if not Player.Parent then
			break
		end

		-- Team menjadi ignored
		if IsIgnoredTeam(Player) then
			break
		end

		-- Character berubah
		-- berarti target respawn
		if Player.Character ~=
			LockedCharacter then

			break

		end

		if IsValidTarget(Player) then

			TeleportTo(Player)

			LastTarget =
				Player

			TeleportDelay()

		else

			task.wait(0.1)

		end

	end

end

local function RunLock()

	local Targets =
		GetTargets()

	for _, Player in ipairs(
		Targets
	) do

		if not Running then
			break
		end

		if Player.Parent then

			RunLockTarget(
				Player
			)

		end

	end

end

--============================================================
-- SURVIVOR
--============================================================

local function RunSurvivor()

	local Targets =
		GetTargets()

	for _, Player in ipairs(
		Targets
	) do

		if not Running then
			break
		end

		-- Hanya target yang masih hidup
		if IsValidTarget(Player) then

			TeleportTo(Player)

			LastTarget =
				Player

			TeleportDelay()

		end

	end

end

--============================================================
-- LAST TARGET
--============================================================

local function RunLast()

	-- Kalau target terakhir masih valid,
	-- prioritaskan dia.
	if LastTarget and
		IsValidTarget(LastTarget) then

		TeleportTo(
			LastTarget
		)

		TeleportDelay()

		return
	end

	-- Kalau target terakhir tidak valid,
	-- cari target baru.
	local Targets =
		GetTargets()

	if #Targets == 0 then
		return
	end

	local Target =
		Targets[1]

	if IsValidTarget(Target) then

		TeleportTo(Target)

		LastTarget =
			Target

		TeleportDelay()

	end

end

--============================================================
-- CYCLE
--============================================================

local function RunCycle()

	local Targets =
		GetTargets()

	if #Targets == 0 then
		return
	end

	RunNormal(Targets)

end

--============================================================
-- RUN CURRENT MODE
--============================================================

local function RunPass()

	local Mode =
		CONFIG.Mode

	if Mode == "Normal" then

		RunNormal(
			GetTargets()
		)

	elseif Mode == "Lock" then

		RunLock()

	elseif Mode == "Random" then

		RunRandom(
			GetTargets()
		)

	elseif Mode == "Nearest" then

		RunNearest()

	elseif Mode == "Cycle" then

		RunCycle()

	elseif Mode == "Hunter" then

		RunHunter()

	elseif Mode == "Ping-Pong" then

		RunPingPong()

	elseif Mode == "Survivor" then

		RunSurvivor()

	elseif Mode == "Last" then

		RunLast()

	end

end

--============================================================
-- TL
--============================================================

local function RunTL()

	if Running then
		return
	end

	Running = true
	LoopMode = false

	LastTarget = nil

	SaveStartPosition()

	Status.Text =
		"TL: " ..
		string.upper(
			CONFIG.Mode
		)

	RunPass()

	if Running then
		ReturnToStart()
	end

	Running = false

	StartCFrame = nil

	Status.Text =
		"FINISHED"

end

--============================================================
-- LTL
--============================================================

local function RunLTL()

	if Running then
		return
	end

	Running = true
	LoopMode = true

	LastTarget = nil

	PingPongForward = true

	SaveStartPosition()

	Status.Text =
		"LTL: " ..
		string.upper(
			CONFIG.Mode
		)

	while Running and
		LoopMode do

		RunPass()

		if not Running then
			break
		end

		task.wait()

	end

	ReturnToStart()

	Running = false
	LoopMode = false

	StartCFrame = nil

	Status.Text =
		"LTL STOPPED"

end

--============================================================
-- STOP
--============================================================

local function Stop()

	if not Running then
		return
	end

	Running = false
	LoopMode = false

	ReturnToStart()

	StartCFrame = nil

	LastTarget = nil

	Status.Text =
		"STOPPED"

end


--============================================================
-- GET ROOT
--============================================================

local function GetRoot()

	local Character =
		LocalPlayer.Character

	if not Character then
		return nil
	end

	return Character:FindFirstChild(
		"HumanoidRootPart"
	)

end

--============================================================
-- SAVE POSITION
--============================================================

local function SaveStartPosition()

	local Root =
		GetRoot()

	if Root then

		StartCFrame =
			Root.CFrame

	else

		StartCFrame = nil

	end

end

--============================================================
-- RETURN
--============================================================

local function ReturnToStart()

	if not CONFIG.ReturnToStart then
		return
	end

	if not StartCFrame then
		return
	end

	local Root =
		GetRoot()

	if Root then

		Root.CFrame =
			StartCFrame

	end

end

--============================================================
-- TEAM CHECK
--============================================================

local function IsIgnoredTeam(Player)

	if not Player then
		return false
	end

	local Team =
		Player.Team

	if not Team then
		return false
	end

	return IgnoredTeams[Team] == true

end

--============================================================
-- VALID TARGET
--============================================================

local function IsValidTarget(Player)

	if not Player then
		return false
	end

	if Player ==
		LocalPlayer then

		return false

	end

	if not Player.Parent then
		return false
	end

	if IsIgnoredTeam(Player) then
		return false
	end

	local Character =
		Player.Character

	if not Character then
		return false
	end

	local Root =
		Character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not Root then
		return false
	end

	local Humanoid =
		Character:FindFirstChildOfClass(
			"Humanoid"
		)

	if Humanoid and
		Humanoid.Health <= 0 then

		return false

	end

	return true

end

--============================================================
-- TELEPORT POSITION
--============================================================

local function GetTargetCFrame(
	TargetRoot
)

	if CONFIG.PositionMode ==
		"Center" then

		return TargetRoot.CFrame

	end

	if CONFIG.PositionMode ==
		"Front" then

		return
			TargetRoot.CFrame *
			CFrame.new(
				0,
				0,
				-CONFIG.Distance
			)

	end

	if CONFIG.PositionMode ==
		"Back" then

		return
			TargetRoot.CFrame *
			CFrame.new(
				0,
				0,
				CONFIG.Distance
			)

	end

	return TargetRoot.CFrame

end

--============================================================
-- TELEPORT
--============================================================

local function TeleportTo(Player)

	local Root =
		GetRoot()

	if not Root then
		return false
	end

	if not IsValidTarget(Player) then
		return false
	end

	local Character =
		Player.Character

	local TargetRoot =
		Character and
		Character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not TargetRoot then
		return false
	end

	Root.CFrame =
		GetTargetCFrame(
			TargetRoot
		)

	return true

end

--============================================================
-- TARGET LIST
--============================================================

local function GetTargets()

	local Targets = {}

	for _, Player in ipairs(
		Players:GetPlayers()
	) do

		if IsValidTarget(Player) then

			table.insert(
				Targets,
				Player
			)

		end

	end

	return Targets

end

--============================================================
-- DELAY
--============================================================

local function TeleportDelay(
	Token
)

	if not Running then
		return false
	end

	if Token ~= ActionToken then
		return false
	end

	if CONFIG.TeleportDelay > 0 then

		task.wait(
			CONFIG.TeleportDelay
		)

	else

		task.wait()

	end

	if not Running then
		return false
	end

	if Token ~= ActionToken then
		return false
	end

	return true

end

--============================================================
-- SHUFFLE
--============================================================

local function Shuffle(Targets)

	for i =
		#Targets,
		2,
		-1 do

		local j =
			math.random(
				1,
				i
			)

		Targets[i],
		Targets[j] =
			Targets[j],
			Targets[i]

	end

end

--============================================================
-- NORMAL
--============================================================

local function RunNormal(
	Targets,
	Token
)

	for _, Player in ipairs(
		Targets
	) do

		if not Running
			or Token ~= ActionToken then

			return

		end

		if IsValidTarget(Player) then

			TeleportTo(
				Player
			)

			LastTarget =
				Player

			if not TeleportDelay(
				Token
			) then

				return

			end

		end

	end

end

--============================================================
-- RANDOM
--============================================================

local function RunRandom(
	Targets,
	Token
)

	Shuffle(Targets)

	RunNormal(
		Targets,
		Token
	)

end

--============================================================
-- NEAREST
--============================================================

local function GetNearestTarget(
	Targets
)

	local Root =
		GetRoot()

	if not Root then
		return nil
	end

	local Best = nil
	local BestDistance =
		math.huge

	for _, Player in ipairs(
		Targets
	) do

		if IsValidTarget(Player) then

			local Character =
				Player.Character

			local TargetRoot =
				Character and
				Character:FindFirstChild(
					"HumanoidRootPart"
				)

			if TargetRoot then

				local Distance =
					(
						Root.Position -
						TargetRoot.Position
					).Magnitude

				if Distance <
					BestDistance then

					BestDistance =
						Distance

					Best =
						Player

				end

			end

		end

	end

	return Best

end

local function RunNearest(
	Token
)

	local Remaining =
		GetTargets()

	while Running
		and Token == ActionToken
		and #Remaining > 0 do

		local Target =
			GetNearestTarget(
				Remaining
			)

		if not Target then
			break
		end

		TeleportTo(
			Target
		)

		LastTarget =
			Target

		if not TeleportDelay(
			Token
		) then

			break

		end

		for i, Player in ipairs(
			Remaining
		) do

			if Player ==
				Target then

				table.remove(
					Remaining,
					i
				)

				break

			end

		end

	end

end

--============================================================
-- HUNTER
--============================================================

local function GetFarthestTarget(
	Targets
)

	local Root =
		GetRoot()

	if not Root then
		return nil
	end

	local Best = nil
	local BestDistance = -1

	for _, Player in ipairs(
		Targets
	) do

		if IsValidTarget(Player) then

			local Character =
				Player.Character

			local TargetRoot =
				Character and
				Character:FindFirstChild(
					"HumanoidRootPart"
				)

			if TargetRoot then

				local Distance =
					(
						Root.Position -
						TargetRoot.Position
					).Magnitude

				if Distance >
					BestDistance then

					BestDistance =
						Distance

					Best =
						Player

				end

			end

		end

	end

	return Best

end

local function RunHunter(
	Token
)

	local Remaining =
		GetTargets()

	while Running
		and Token == ActionToken
		and #Remaining > 0 do

		local Target =
			GetFarthestTarget(
				Remaining
			)

		if not Target then
			break
		end

		TeleportTo(
			Target
		)

		LastTarget =
			Target

		if not TeleportDelay(
			Token
		) then
			break
		end

		for i, Player in ipairs(
			Remaining
		) do

			if Player ==
				Target then

				table.remove(
					Remaining,
					i
				)

				break

			end

		end

	end

end

--============================================================
-- PING PONG
--============================================================

local function RunPingPong(
	Token
)

	local Targets =
		GetTargets()

	table.sort(
		Targets,
		function(A,B)

			return A.Name <
				B.Name

		end
	)

	if #Targets == 0 then
		return
	end

	if PingPongForward then

		for i = 1,#Targets do

			if not Running
				or Token ~= ActionToken then

				return

			end

			local Player =
				Targets[i]

			if IsValidTarget(
				Player
			) then

				TeleportTo(
					Player
				)

				LastTarget =
					Player

				if not TeleportDelay(
					Token
				) then

					return

				end

			end

		end

	else

		for i =
			#Targets,
			1,
			-1 do

			if not Running
				or Token ~= ActionToken then

				return

			end

			local Player =
				Targets[i]

			if IsValidTarget(
				Player
			) then

				TeleportTo(
					Player
				)

				LastTarget =
					Player

				if not TeleportDelay(
					Token
				) then

					return

				end

			end

		end

	end

	PingPongForward =
		not PingPongForward

end

--============================================================
-- LOCK MODE
--============================================================

local function RunLockTarget(
	Player,
	Token
)

	if not Player then
		return
	end

	local LockedCharacter =
		Player.Character

	if not LockedCharacter then
		return
	end

	while Running
		and Token == ActionToken do

		if not Player.Parent then
			break
		end

		if IsIgnoredTeam(
			Player
		) then

			break

		end

		-- Target respawned
		if Player.Character ~=
			LockedCharacter then

			break

		end

		if IsValidTarget(
			Player
		) then

			TeleportTo(
				Player
			)

			LastTarget =
				Player

			if not TeleportDelay(
				Token
			) then

				break

			end

		else

			task.wait(0.1)

		end

	end

end

local function RunLock(
	Token
)

	local Target =
		LockedPlayer
		or SelectedPlayer

	if Target then

		-- Kalau player sudah dipilih/locked,
		-- jadikan dia prioritas pertama.
		RunLockTarget(
			Target,
			Token
		)

	end

	if not Running
		or Token ~= ActionToken then

		return

	end

	-- Setelah target locked respawn,
	-- lanjut ke target lain.
	local Targets =
		GetTargets()

	for _, Player in ipairs(
		Targets
	) do

		if not Running
			or Token ~= ActionToken then

			return

		end

		if Player ~=
			Target then

			RunLockTarget(
				Player,
				Token
			)

		end

	end

end

--============================================================
-- SURVIVOR
--============================================================

local function RunSurvivor(
	Token
)

	local Targets =
		GetTargets()

	for _, Player in ipairs(

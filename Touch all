--============================================================
-- GET ROOT
--============================================================

local function GetRoot()

	local Character =
		LocalPlayer.Character

	if not Character then
		return nil
	end

	return Character:FindFirstChild(
		"HumanoidRootPart"
	)
end

--============================================================
-- SAVE START
--============================================================

local function SaveStartPosition()

	local Root = GetRoot()

	if Root then
		StartCFrame = Root.CFrame
	else
		StartCFrame = nil
	end
end

--============================================================
-- RETURN
--============================================================

local function ReturnToStart()

	if not CONFIG.ReturnToStart then
		return
	end

	if not StartCFrame then
		return
	end

	local Root = GetRoot()

	if Root then
		Root.CFrame = StartCFrame
	end
end

--============================================================
-- TEAM CHECK
--============================================================

local function IsIgnoredTeam(Player)

	local Team = Player.Team

	if not Team then
		return false
	end

	return IgnoredTeams[Team] == true
end

--============================================================
-- TARGET CHECK
--============================================================

local function IsValidTarget(Player)

	if Player == LocalPlayer then
		return false
	end

	if IsIgnoredTeam(Player) then
		return false
	end

	local Character =
		Player.Character

	if not Character then
		return false
	end

	local Root =
		Character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not Root then
		return false
	end

	local Humanoid =
		Character:FindFirstChildOfClass(
			"Humanoid"
		)

	if Humanoid and Humanoid.Health <= 0 then
		return false
	end

	return true
end

--============================================================
-- TELEPORT
--============================================================

local function TeleportTo(Player)

	local Root = GetRoot()

	if not Root then
		return false
	end

	if not IsValidTarget(Player) then
		return false
	end

	local Character =
		Player.Character

	if not Character then
		return false
	end

	local TargetRoot =
		Character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not TargetRoot then
		return false
	end

	Root.CFrame =
		TargetRoot.CFrame *
		CONFIG.TargetOffset

	return true
end

--============================================================
-- TARGET LIST
--============================================================

local function GetTargets()

	local Targets = {}

	for _, Player in ipairs(
		Players:GetPlayers()
	) do

		if IsValidTarget(Player) then
			table.insert(Targets, Player)
		end

	end

	return Targets
end

--============================================================
-- DELAY
--============================================================

local function TeleportDelay()

	if CONFIG.TeleportDelay > 0 then

		task.wait(
			CONFIG.TeleportDelay
		)

	else

		task.wait()

	end
end

--============================================================
-- RANDOM SHUFFLE
--============================================================

local function Shuffle(Targets)

	for i = #Targets, 2, -1 do

		local j =
			math.random(1, i)

		Targets[i],
		Targets[j] =
			Targets[j],
			Targets[i]

	end

end

--============================================================
-- NEAREST TARGET
--============================================================

local function GetNearestTarget(Targets)

	local Root = GetRoot()

	if not Root then
		return nil
	end

	local Nearest = nil
	local NearestDistance = math.huge

	for _, Player in ipairs(Targets) do

		if IsValidTarget(Player) then

			local Character =
				Player.Character

			local TargetRoot =
				Character and
				Character:FindFirstChild(
					"HumanoidRootPart"
				)

			if TargetRoot then

				local Distance =
					(
						Root.Position -
						TargetRoot.Position
					).Magnitude

				if Distance <
					NearestDistance then

					NearestDistance =
						Distance

					Nearest = Player
				end
			end
		end
	end

	return Nearest
end

--============================================================
-- LOCK TARGET
--============================================================

local function RunLockTarget(
	Player
)

	if not Player then
		return
	end

	-- Character saat pertama kali dikunci
	local LockedCharacter =
		Player.Character

	if not LockedCharacter then
		return
	end

	Status.Text =
		"LOCKED: " .. Player.Name

	while Running do

		-- Player keluar
		if not Player.Parent then
			break
		end

		-- Character berubah berarti
		-- target sudah respawn
		if Player.Character ~=
			LockedCharacter then

			break
		end

		-- Tetap teleport ke target
		if IsValidTarget(Player) then

			TeleportTo(Player)

			TeleportDelay()

		else

			-- Tunggu target hidup kembali
			task.wait(0.1)

		end
	end
end

--============================================================
-- NORMAL MODE
--============================================================

local function RunNormal(
	Targets
)

	for _, Player in ipairs(Targets) do

		if not Running then
			break
		end

		if IsValidTarget(Player) then

			TeleportTo(Player)

			TeleportDelay()

		end
	end
end

--============================================================
-- RANDOM MODE
--============================================================

local function RunRandom(
	Targets
)

	Shuffle(Targets)

	for _, Player in ipairs(Targets) do

		if not Running then
			break
		end

		if IsValidTarget(Player) then

			TeleportTo(Player)

			TeleportDelay()

		end
	end
end

--============================================================
-- NEAREST MODE
--============================================================

local function RunNearest()

	local Remaining = GetTargets()

	while Running and #Remaining > 0 do

		local Target =
			GetNearestTarget(Remaining)

		if not Target then
			break
		end

		if IsValidTarget(Target) then

			TeleportTo(Target)

			TeleportDelay()

		end

		for i, Player in ipairs(Remaining) do

			if Player == Target then

				table.remove(
					Remaining,
					i
				)

				break
			end
		end
	end
end

--============================================================
-- LOCK MODE
--============================================================

local function RunLock(
	Targets
)

	for _, Player in ipairs(Targets) do

		if not Running then
			break
		end

		if Player.Parent then

			RunLockTarget(Player)

		end
	end
end

--============================================================
-- CYCLE MODE
--============================================================

local function RunCycle()

	local Targets =
		GetTargets()

	if #Targets == 0 then
		return
	end

	-- Satu cycle penuh
	RunNormal(Targets)

end

--============================================================
-- RUN ONE PASS
--============================================================

local function RunPass()

	local Mode =
		CONFIG.Mode

	if Mode == "Normal" then

		local Targets =
			GetTargets()

		RunNormal(Targets)

	elseif Mode == "Random" then

		local Targets =
			GetTargets()

		RunRandom(Targets)

	elseif Mode == "Nearest" then

		RunNearest()

	elseif Mode == "Lock" then

		local Targets =
			GetTargets()

		RunLock(Targets)

	elseif Mode == "Cycle" then

		RunCycle()

	end
end

--============================================================
-- TL
--============================================================

local function RunTL()

	if Running then
		return
	end

	Running = true
	LoopMode = false

	SaveStartPosition()

	Status.Text =
		"RUNNING: " ..
		string.upper(CONFIG.Mode)

	RunPass()

	if Running then
		ReturnToStart()
	end

	Running = false

	StartCFrame = nil

	Status.Text =
		"FINISHED: " ..
		string.upper(CONFIG.Mode)

end

--============================================================
-- LTL
--============================================================

local function RunLTL()

	if Running then
		return
	end

	Running = true
	LoopMode = true

	SaveStartPosition()

	Status.Text =
		"LOOP: " ..
		string.upper(CONFIG.Mode)

	while Running and LoopMode do

		RunPass()

		if not Running then
			break
		end

		-- Normal / Random / Nearest /
		-- Cycle akan mengulang.
		--
		-- Lock akan menunggu target
		-- respawn sebelum lanjut.

		if CONFIG.Mode ~= "Lock" then

			task.wait()

		end
	end

	ReturnToStart()

	Running = false
	LoopMode = false

	StartCFrame = nil

	Status.Text = "LTL STOPPED"

end

--============================================================
-- STOP
--============================================================

local function Stop()

	if not Running then
		return
	end

	Running = false
	LoopMode = false

	ReturnToStart()

	StartCFrame = nil

	Status.Text = "STOPPED"

end


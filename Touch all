local function UpdateDelay()

	local Number =
		tonumber(DelayBox.Text)

	if Number == nil then

		DelayBox.Text =
			tostring(CONFIG.TeleportDelay)

		return
	end

	Number =
		math.clamp(
			Number,
			0,
			CONFIG.MaxDelay
		)

	CONFIG.TeleportDelay = Number

	DelayBox.Text =
		tostring(Number)
end


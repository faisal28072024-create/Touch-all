------------------------------------------------------------
-- NEAREST
------------------------------------------------------------

local function GetNearestTarget()

	local localRoot =
		GetCharacterRoot(
			LocalPlayer
		)

	if not localRoot then
		return nil
	end

	local bestPlayer = nil
	local bestDistance = math.huge

	for _, player in ipairs(
		GetTargets()
	) do

		local root =
			GetCharacterRoot(
				player
			)

		if root then

			local distance =
				(
					root.Position
					- localRoot.Position
				).Magnitude

			if distance <
				bestDistance then

				bestDistance =
					distance

				bestPlayer =
					player
			end
		end
	end

	return bestPlayer
end


	while #remaining > 0 do

		if not TeleportDelay(
			Token
		) then

			return
		end

		local localRoot =
			GetCharacterRoot(
				LocalPlayer
			)

		if not localRoot then
			return
		end

		local bestIndex = nil
		local bestDistance = -math.huge

		for index, player
			in ipairs(
				remaining
			) do

			if IsValidTarget(
				player
			) then

				local root =
					GetCharacterRoot(
						player
					)

				if root then

					local distance =
						(
							root.Position
							- localRoot.Position
						).Magnitude

					if distance >
						bestDistance then

						bestDistance =
							distance

						bestIndex =
							index
					end
				end
			end
		end

		if not bestIndex then
			break
		end

		local target =
			table.remove(
				remaining,
				bestIndex
			)

		if IsValidTarget(
			target
		) then

			TeleportTo(
				target
			)

			Status.Text =
				"Status: HUNTER → "
				.. target.Name
		end
	end
end


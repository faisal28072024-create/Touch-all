------------------------------------------------------------
-- DELAY
------------------------------------------------------------

local function TeleportDelay(
	token
)

	if not Running then
		return false
	end

	if token ~= ActionToken then
		return false
	end

	local delayTime =
		math.clamp(
			tonumber(
				CONFIG.TeleportDelay
			) or 0,
			0,
			CONFIG.MaxDelay
		)

	if delayTime > 0 then

		task.wait(
			delayTime
		)
	end

	return Running
		and token == ActionToken
end


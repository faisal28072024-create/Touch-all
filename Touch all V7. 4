------------------------------------------------------------

local function SortAlphabetical(
	list
)

	table.sort(
		list,
		function(a, b)

			return string.lower(
				a.Name
			)
			<
			string.lower(
				b.Name
			)
		end
	)

	return list
end

------------------------------------------------------------
-- TARGET CFRAME
------------------------------------------------------------

local function GetTargetCFrame(
	player
)

	local root =
		GetCharacterRoot(
			player
		)

	if not root then
		return nil
	end

	if CONFIG.PositionMode ==
		"Front" then

		return root.CFrame *
			CFrame.new(
				0,
				0,
				-CONFIG.Distance
			)
	end

	if CONFIG.PositionMode ==
		"Back" then

		return root.CFrame *
			CFrame.new(
				0,
				0,
				CONFIG.Distance
			)
	end

	return root.CFrame
end


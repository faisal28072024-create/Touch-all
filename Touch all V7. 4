------------------------------------------------------------

local function TeleportTo(
	player
)

	if not IsValidTarget(
		player
	) then

		return false
	end

	local localRoot =
		GetCharacterRoot(
			LocalPlayer
		)

	if not localRoot then
		return false
	end

	local targetCFrame =
		GetTargetCFrame(
			player
		)

	if not targetCFrame then
		return false
	end

	localRoot.CFrame =
		targetCFrame

	LastTarget =
		player

	return true
end


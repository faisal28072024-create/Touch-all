------------------------------------------------------------
-- LOCK TARGET
------------------------------------------------------------

local function RunLockTarget(
	player,
	Token
)

	if not player then
		return
	end

	local originalCharacter =
		player.Character

	while Running
		and Token ==
			ActionToken do

		if not IsValidTarget(
			player
		) then

			task.wait(
				0.2
			)

			------------------------------------------------
			-- Player respawned
			------------------------------------------------

			if player.Character
				~=
				originalCharacter then

				originalCharacter =
					player.Character
			end

		else

			if not TeleportDelay(
				Token
			) then

				return
			end

			if IsValidTarget(
				player
			) then

				TeleportTo(
					player
				)

				Status.Text =
					"Status: LOCK → "
					.. player.Name
			end
		end

		----------------------------------------------------
		-- Character changed:
		-- return to outer LTL loop so the new character
		-- gets detected again.
		----------------------------------------------------

		if player.Character
			~=
			originalCharacter then

			break
		end
	end
end

------------------------------------------------------------
-- LOCK MODE
------------------------------------------------------------

local function RunLock(
	Token
)

	local target =
		LockedPlayer
		or SelectedPlayer

	if target
		and IsValidTarget(
			target
		) then

		RunLockTarget(
			target,
			Token
		)

		return
	end

	local targets =
		GetTargets()

	if #targets == 0 then
		return
	end

	local fallback =
		targets[
			math.random(
				1,
				#targets
			)
		]

	RunLockTarget(
		fallback,
		Token
	)
end


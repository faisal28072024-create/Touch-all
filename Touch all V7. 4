------------------------------------------------------------

local function RunRandom(
	Token
)

	local targets =
		GetTargets()

	for i = #targets, 2, -1 do

		local j =
			math.random(
				1,
				i
			)

		targets[i],
		targets[j] =
			targets[j],
			targets[i]
	end

	for _, player in ipairs(
		targets
	) do

		if not TeleportDelay(
			Token
		) then

			return
		end

		if IsValidTarget(
			player
		) then

			TeleportTo(
				player
			)

			Status.Text =
				"Status: RANDOM → "
				.. player.Name
		end
	end
end

------------------------------------------------------------
-- NEAREST TL
------------------------------------------------------------

local function RunNearest(
	Token
)

	local remaining =
		GetTargets()

	while #remaining > 0 do

		if not TeleportDelay(
			Token
		) then

			return
		end

		local localRoot =
			GetCharacterRoot(
				LocalPlayer
			)

		if not localRoot then
			return
		end

		local bestIndex = nil
		local bestDistance = math.huge

		for index, player
			in ipairs(
				remaining
			) do

			if IsValidTarget(
				player
			) then

				local root =
					GetCharacterRoot(
						player
					)

				if root then

					local distance =
						(
							root.Position
							- localRoot.Position
						).Magnitude

					if distance <
						bestDistance then

						bestDistance =
							distance

						bestIndex =
							index
					end
				end
			end
		end

		if not bestIndex then
			break
		end

		local target =
			table.remove(
				remaining,
				bestIndex
			)

		if IsValidTarget(
			target
		) then

			TeleportTo(
				target
			)

			Status.Text =
				"Status: NEAREST → "
				.. target.Name
		end
	end
end


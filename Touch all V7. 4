local function GetNormalTPTarget()

	--------------------------------------------------------
	-- LOCK ALWAYS HAS PRIORITY
	--------------------------------------------------------

	if LockedPlayer
		and IsValidTarget(
			LockedPlayer
		) then

		return LockedPlayer
	end

	--------------------------------------------------------
	-- INVALID LOCK
	--------------------------------------------------------

	if LockedPlayer
		and not IsValidTarget(
			LockedPlayer
		) then

		LockedPlayer =
			nil

		UpdateTargetInfo()
	end

	--------------------------------------------------------
	-- MODE
	--------------------------------------------------------

	if CONFIG.Mode ==
		"Random" then

		return GetRandomTarget()
	end

	if CONFIG.Mode ==
		"Normal" then

		return GetRandomTarget()
	end

	if CONFIG.Mode ==
		"Lock" then

		return GetRandomTarget()
	end

	if CONFIG.Mode ==
		"Nearest" then

		return GetNearestTarget()
	end

	if CONFIG.Mode ==
		"Cycle" then

		return GetCycleTarget()
	end

	if CONFIG.Mode ==
		"Hunter" then

		return GetHunterTarget()
	end

	if CONFIG.Mode ==
		"Ping-Pong" then

		return GetPingPongTarget()
	end

	if CONFIG.Mode ==
		"Survivor" then

		return GetRandomTarget()
	end

	if CONFIG.Mode ==
		"Last" then

		return GetLastTarget()
	end

	return GetRandomTarget()
end


------------------------------------------------------------
-- TL
------------------------------------------------------------

local function RunTL()

	ActionToken += 1

	local Token =
		ActionToken

	Running = true
	LoopMode = false

	CurrentActionReturns =
		CONFIG.ReturnToStart

	SaveStartPosition()

	Status.Text =
		"Status: TL RUNNING"

	RunPass(
		Token
	)

	if Token ~=
		ActionToken then

		return
	end

	Running = false

	if CurrentActionReturns then
		ReturnToStart()
	end

	CurrentActionReturns =
		false

	Status.Text =
		"Status: TL COMPLETE"

	StartCFrame = nil
end

------------------------------------------------------------
-- LTL
--
-- V7.4 IMPORTANT:
-- LockedPlayer gets PRIORITY over every Mode.
------------------------------------------------------------

local function RunLTL()

	ActionToken += 1

	local Token =
		ActionToken

	Running = true
	LoopMode = true

	CurrentActionReturns =
		CONFIG.ReturnToStart

	SaveStartPosition()

	if LockedPlayer
		and IsValidTarget(
			LockedPlayer
		) then

		Status.Text =
			"LTL LOCKED → "
			.. LockedPlayer.Name

	else

		Status.Text =
			"Status: LTL RUNNING"
	end

	while Running
		and LoopMode
		and Token ==
			ActionToken do

		----------------------------------------------------
		-- V7.4 HARD LOCK PRIORITY
		----------------------------------------------------

		if LockedPlayer
			and IsValidTarget(
				LockedPlayer
			) then

			RunLockTarget(
				LockedPlayer,
				Token
			)

		else

			------------------------------------------------
			-- No active lock:
			-- use selected mode normally.
			------------------------------------------------

			RunPass(
				Token
			)
		end

		if not Running
			or not LoopMode
			or Token ~=
				ActionToken then

			break
		end

		task.wait()
	end

	if Token ~=
		ActionToken then

		return
	end

	if CurrentActionReturns then
		ReturnToStart()
	end

	Running = false
	LoopMode = false

	CurrentActionReturns =
		false

	StartCFrame = nil

	Status.Text =
		"Status: LTL STOPPED"
end


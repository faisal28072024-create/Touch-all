local function New(
	className,
	properties,
	parent
)

	local obj =
		Instance.new(className)

	for property, value in pairs(
		properties or {}
	) do

		obj[property] =
			value
	end

	obj.Parent =
		parent

	return obj
end

local function AddCorner(
	object,
	radius
)

	local corner =
		Instance.new(
			"UICorner"
		)

	corner.CornerRadius =
		UDim.new(
			0,
			radius or 6
		)

	corner.Parent =
		object

	return corner
end

local function AddStroke(
	object,
	thickness,
	transparency
)

	local stroke =
		Instance.new(
			"UIStroke"
		)

	stroke.Thickness =
		thickness or 1

	stroke.Transparency =
		transparency or 0

	stroke.Parent =
		object

	return stroke
end


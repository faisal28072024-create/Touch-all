------------------------------------------------------------
-- PING PONG TL
------------------------------------------------------------

local function RunPingPong(
	Token
)

	local targets =
		GetTargets()

	SortAlphabetical(
		targets
	)

	if #targets == 0 then
		return
	end

	if not PingPongForward then

		table.reverse(
			targets
		)
	end

	for _, player in ipairs(
		targets
	) do

		if not TeleportDelay(
			Token
		) then

			return
		end

		if IsValidTarget(
			player
		) then

			TeleportTo(
				player
			)

			Status.Text =
				"Status: PING-PONG → "
				.. player.Name
		end
	end

	PingPongForward =
		not PingPongForward
end


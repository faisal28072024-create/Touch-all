------------------------------------------------------------
-- DRAG CLAMP
------------------------------------------------------------

local function ClampPosition(
	position,
	object
)

	local camera =
		workspace.CurrentCamera

	if not camera then
		return position
	end

	local viewport =
		camera.ViewportSize

	local objectWidth =
		object.AbsoluteSize.X

	local objectHeight =
		object.AbsoluteSize.Y

	local maxX =
		math.max(
			0,
			viewport.X - objectWidth
		)

	local maxY =
		math.max(
			0,
			viewport.Y - objectHeight
		)

	local x =
		math.clamp(
			position.X.Offset,
			0,
			maxX
		)

	local y =
		math.clamp(
			position.Y.Offset,
			0,
			maxY
		)

	return UDim2.fromOffset(
		x,
		y
	)
end

------------------------------------------------------------
-- V7.6 DRAG SYSTEM
------------------------------------------------------------

local DRAG_THRESHOLD = 8

local function MakeDraggable(
	object,
	handle
)

	local dragging = false

	local dragStarted = false

	local inputObject = nil

	local dragStart = nil

	local startPosition = nil

	local function BeginDrag(input)

		dragging = true

		dragStarted = false

		inputObject =
			input

		dragStart =
			input.Position

		startPosition =
			object.Position
	end

	local function EndDrag()

		dragging = false

		dragStarted = false

		inputObject = nil

		dragStart = nil

		startPosition = nil
	end

	handle.InputBegan:Connect(
		function(input)

			if input.UserInputType
				==
				Enum.UserInputType.MouseButton1
				or
				input.UserInputType
				==
				Enum.UserInputType.Touch then

				BeginDrag(input)
			end
		end
	)

	handle.InputEnded:Connect(
		function(input)

			if input.UserInputType
				==
				Enum.UserInputType.MouseButton1
				or
				input.UserInputType
				==
				Enum.UserInputType.Touch then

				if input == inputObject then
					EndDrag()
				end
			end
		end
	)

	UserInputService.InputChanged:Connect(
		function(input)

			if not dragging then
				return
			end

			------------------------------------------------
			-- Mouse movement
			------------------------------------------------

			local position

			if input.UserInputType
				==
				Enum.UserInputType.MouseMovement then

				position =
					input.Position

			------------------------------------------------
			-- Touch movement
			------------------------------------------------

			elseif input.UserInputType
				==
				Enum.UserInputType.Touch then

				if inputObject
					and input ~= inputObject then

					return
				end

				position =
					input.Position

			else

				return
			end

			if not position
				or not dragStart
				or not startPosition then

				return
			end

			local delta =
				position -
				dragStart

			------------------------------------------------
			-- DRAG THRESHOLD
			------------------------------------------------

			if not dragStarted then

				if delta.Magnitude <
					DRAG_THRESHOLD then

					return
				end

				dragStarted = true
			end

			------------------------------------------------
			-- MOVE
			------------------------------------------------

			local newPosition =
				UDim2.fromOffset(

					startPosition.X.Offset
					+
					delta.X,

					startPosition.Y.Offset
					+
					delta.Y
				)

			object.Position =
				ClampPosition(
					newPosition,
					object
				)
		end
	)

	UserInputService.InputEnded:Connect(
		function(input)

			if input.UserInputType
				==
				Enum.UserInputType.MouseButton1
				or
				input.UserInputType
				==
				Enum.UserInputType.Touch then

				if input == inputObject then

					EndDrag()
				end
			end
		end
	)
end


------------------------------------------------------------
-- TARGET PICKERS
------------------------------------------------------------

local function GetRandomTarget()

	local targets =
		GetTargets()

	if #targets == 0 then
		return nil
	end

	return targets[
		math.random(
			1,
			#targets
		)
	]
end

local function GetNearestTarget()

	local localRoot =
		GetRoot(LocalPlayer)

	if not localRoot then
		return nil
	end

	local best
	local bestDistance =
		math.huge

	for _, player in ipairs(
		GetTargets()
	) do

		local root =
			GetRoot(player)

		if root then

			local distance =
				(
					root.Position
					-
					localRoot.Position
				).Magnitude

			if distance <
				bestDistance then

				bestDistance =
					distance

				best =
					player
			end
		end
	end

	return best
end

local function GetHunterTarget()

	local localRoot =
		GetRoot(LocalPlayer)

	if not localRoot then
		return nil
	end

	local best
	local bestDistance =
		-math.huge

	for _, player in ipairs(
		GetTargets()
	) do

		local root =
			GetRoot(player)

		if root then

			local distance =
				(
					root.Position
					-
					localRoot.Position
				).Magnitude

			if distance >
				bestDistance then

				bestDistance =
					distance

				best =
					player
			end
		end
	end

	return best
end

local function GetCycleTarget()

	local targets =
		GetTargets()

	if #targets == 0 then
		return nil
	end

	SortPlayers(targets)

	if CycleIndex >
		#targets then

		CycleIndex = 1
	end

	local target =
		targets[CycleIndex]

	CycleIndex += 1

	if CycleIndex >
		#targets then

		CycleIndex = 1
	end

	return target
end

local function GetPingPongTarget()

	local targets =
		GetTargets()

	if #targets == 0 then
		return nil
	end

	SortPlayers(targets)

	local target

	if PingPongForward then

		target =
			targets[1]

	else

		target =
			targets[#targets]
	end

	PingPongForward =
		not PingPongForward

	return target
end

local function GetLastTarget()

	if LastTarget
		and IsValidTarget(
			LastTarget
		) then

		return LastTarget
	end

	return GetRandomTarget()
end

------------------------------------------------------------
-- NORMAL TP TARGET
------------------------------------------------------------

local function GetNormalTPTarget()

	if LockedPlayer
		and IsValidTarget(
			LockedPlayer
		) then

		return LockedPlayer
	end

	if CONFIG.Mode ==
		"Nearest" then

		return GetNearestTarget()
	end

	if CONFIG.Mode ==
		"Hunter" then

		return GetHunterTarget()
	end

	if CONFIG.Mode ==
		"Cycle" then

		return GetCycleTarget()
	end

	if CONFIG.Mode ==
		"Ping-Pong" then

		return GetPingPongTarget()
	end

	if CONFIG.Mode ==
		"Last" then

		return GetLastTarget()
	end

	return GetRandomTarget()
end

------------------------------------------------------------
-- NORMAL PASS
------------------------------------------------------------

local function RunNormal(token)

	local targets =
		GetTargets()

	for _, player in ipairs(
		targets
	) do

		if not TeleportDelay(token) then
			return
		end

		if IsValidTarget(player) then

			TeleportTo(player)

			Status.Text =
				"Status: TL → "
				.. player.Name
		end
	end
end

------------------------------------------------------------
-- RANDOM
------------------------------------------------------------

local function RunRandom(token)

	local targets =
		GetTargets()

	for i = #targets, 2, -1 do

		local j =
			math.random(
				1,
				i
			)

		targets[i],
		targets[j] =
			targets[j],
			targets[i]
	end

	for _, player in ipairs(
		targets
	) do

		if not TeleportDelay(token) then
			return
		end

		if IsValidTarget(player) then

			TeleportTo(player)

			Status.Text =
				"Status: RANDOM → "
				.. player.Name
		end
	end
end

------------------------------------------------------------
-- CYCLE
------------------------------------------------------------

local function RunCycle(token)

	local targets =
		GetTargets()

	SortPlayers(targets)

	for _, player in ipairs(
		targets
	) do

		if not TeleportDelay(token) then
			return
		end

		if IsValidTarget(player) then

			TeleportTo(player)

			Status.Text =
				"Status: CYCLE → "
				.. player.Name
		end
	end
end

------------------------------------------------------------
-- NEAREST
------------------------------------------------------------

local function RunNearest(token)

	local remaining =
		GetTargets()

	while #remaining > 0 do

		if not TeleportDelay(token) then
			return
		end

		local localRoot =
			GetRoot(LocalPlayer)

		if not localRoot then
			return
		end

		local bestIndex
		local bestDistance =
			math.huge

		for i, player in ipairs(
			remaining
		) do

			if IsValidTarget(player) then

				local root =
					GetRoot(player)

				if root then

					local distance =
						(
							root.Position
							-
							localRoot.Position
						).Magnitude

					if distance <
						bestDistance then

						bestDistance =
							distance

						bestIndex =
							i
					end
				end
			end
		end

		if not bestIndex then
			break
		end

		local target =
			table.remove(
				remaining,
				bestIndex
			)

		if IsValidTarget(target) then

			TeleportTo(target)

			Status.Text =
				"Status: NEAREST → "
				.. target.Name
		end
	end
end

------------------------------------------------------------
-- HUNTER
------------------------------------------------------------

local function RunHunter(token)

	local remaining =
		GetTargets()

	while #remaining > 0 do

		if not TeleportDelay(token) then
			return
		end

		local localRoot =
			GetRoot(LocalPlayer)

		if not localRoot then
			return
		end

		local bestIndex
		local bestDistance =
			-math.huge

		for i, player in ipairs(
			remaining
		) do

			if IsValidTarget(player) then

				local root =
					GetRoot(player)

				if root then

					local distance =
						(
							root.Position
							-
							localRoot.Position
						).Magnitude

					if distance >
						bestDistance then

						bestDistance =
							distance

						bestIndex =
							i
					end
				end
			end
		end

		if not bestIndex then
			break
		end

		local target =
			table.remove(
				remaining,
				bestIndex
			)

		if IsValidTarget(target) then

			TeleportTo(target)

			Status.Text =
				"Status: HUNTER → "
				.. target.Name
		end
	end
end

------------------------------------------------------------
-- PING PONG
------------------------------------------------------------

local function RunPingPong(token)

	local targets =
		GetTargets()

	SortPlayers(targets)

	if not PingPongForward then

		table.reverse(targets)
	end

	for _, player in ipairs(
		targets
	) do

		if not TeleportDelay(token) then
			return
		end

		if IsValidTarget(player) then

			TeleportTo(player)

			Status.Text =
				"Status: PING-PONG → "
				.. player.Name
		end
	end

	PingPongForward =
		not PingPongForward
end

------------------------------------------------------------
-- LAST
------------------------------------------------------------

local function RunLast(token)

	local target =
		GetLastTarget()

	if not target then
		return
	end

	if not TeleportDelay(token) then
		return
	end

	if IsValidTarget(target) then

		TeleportTo(target)

		Status.Text =
			"Status: LAST → "
			.. target.Name
	end
end

------------------------------------------------------------
-- LOCK TARGET
------------------------------------------------------------

local function RunLockTarget(
	player,
	token
)

	if not player then
		return
	end

	while Running
		and token ==
			ActionToken do

		if IsValidTarget(player) then

			if not TeleportDelay(token) then
				return
			end

			if IsValidTarget(player) then

				TeleportTo(player)

				Status.Text =
					"Status: LOCK → "
					.. player.Name
			end

		else

			task.wait(0.15)
		end
	end
end

------------------------------------------------------------
-- LOCK MODE
------------------------------------------------------------

local function RunLock(token)

	local target =
		LockedPlayer
		or SelectedPlayer

	if target then

		RunLockTarget(
			target,
			token
		)

		return
	end

	local fallback =
		GetRandomTarget()

	if fallback then

		RunLockTarget(
			fallback,
			token
		)
	end
end

------------------------------------------------------------
-- PASS
------------------------------------------------------------

local function RunPass(token)

	if CONFIG.Mode ==
		"Normal" then

		RunNormal(token)

	elseif CONFIG.Mode ==
		"Lock" then

		RunLock(token)

	elseif CONFIG.Mode ==
		"Random" then

		RunRandom(token)

	elseif CONFIG.Mode ==
		"Nearest" then

		RunNearest(token)

	elseif CONFIG.Mode ==
		"Cycle" then

		RunCycle(token)

	elseif CONFIG.Mode ==
		"Hunter" then

		RunHunter(token)

	elseif CONFIG.Mode ==
		"Ping-Pong" then

		RunPingPong(token)

	elseif CONFIG.Mode ==
		"Survivor" then

		RunNormal(token)

	elseif CONFIG.Mode ==
		"Last" then

		RunLast(token)
	end
end

------------------------------------------------------------
-- NORMAL TP
------------------------------------------------------------

local function RunNormalTP()

	ActionToken += 1

	local token =
		ActionToken

	Running = true

	LoopMode = false

	CurrentActionReturns =
		false

	local target =
		GetNormalTPTarget()

	if not target then

		Running = false

		Status.Text =
			"Status: NO VALID TARGET"

		return
	end

	if not TeleportDelay(token) then

		Running = false

		return
	end

	if IsValidTarget(target) then

		TeleportTo(target)

		Status.Text =
			"NORMAL TP → "
			.. target.Name

	else

		Status.Text =
			"Status: TARGET INVALID"
	end

	Running = false

	LoopMode = false

	StartCFrame = nil
end

------------------------------------------------------------
-- TL
------------------------------------------------------------

local function RunTL()

	ActionToken += 1

	local token =
		ActionToken

	Running = true

	LoopMode = false

	CurrentActionReturns =
		CONFIG.ReturnToStart

	SaveStartPosition()

	Status.Text =
		"Status: TL RUNNING"

	RunPass(token)

	if token ~=
		ActionToken then

		return
	end

	Running = false

	if CurrentActionReturns then
		ReturnToStart()
	end

	CurrentActionReturns =
		false

	StartCFrame = nil

	Status.Text =
		"Status: TL COMPLETE"
end

------------------------------------------------------------
-- LTL
------------------------------------------------------------

local function RunLTL()

	ActionToken += 1

	local token =
		ActionToken

	Running = true

	LoopMode = true

	CurrentActionReturns =
		CONFIG.ReturnToStart

	SaveStartPosition()

	if LockedPlayer then

		Status.Text =
			"LTL LOCKED → "
			.. LockedPlayer.Name

	else

		Status.Text =
			"Status: LTL RUNNING"
	end

	while Running
		and LoopMode
		and token ==
			ActionToken do

		----------------------------------------------------
		-- HARD LOCK
		----------------------------------------------------

		if LockedPlayer then

			RunLockTarget(
				LockedPlayer,
				token
			)

		else

			RunPass(token)
		end

		if not Running
			or not LoopMode
			or token ~=
				ActionToken then

			break
		end

		task.wait()
	end

	if token ~=
		ActionToken then

		return
	end

	if CurrentActionReturns then
		ReturnToStart()
	end

	Running = false

	LoopMode = false

	CurrentActionReturns =
		false

	StartCFrame = nil

	Status.Text =
		"Status: LTL STOPPED"
end

------------------------------------------------------------
-- STOP
------------------------------------------------------------

local function StopForce()

	ActionToken += 1

	local shouldReturn =
		CurrentActionReturns

	Running = false

	LoopMode = false

	CurrentActionReturns =
		false

	if shouldReturn then
		ReturnToStart()
	end

	StartCFrame = nil

	LastTarget = nil

	Status.Text =
		"Status: STOP FORCE"
end

------------------------------------------------------------
-- GUI DETECTION
------------------------------------------------------------

local function IsOverOurGui(
	position
)

	local objects =
		PlayerGui:GetGuiObjectsAtPosition(
			position.X,
			position.Y
		)

	for _, object in ipairs(objects) do

		if object:IsDescendantOf(
			ScreenGui
		) then

			return true
		end
	end

	return false
end

------------------------------------------------------------
-- CLICK TARGET RAYCAST
------------------------------------------------------------

local function GetPlayerFromPart(
	part
)

	if not part then
		return nil
	end

	local current =
		part

	while current
		and current ~= workspace do

		if current:IsA("Model") then

			local player =
				Players:GetPlayerFromCharacter(
					current
				)

			if player then
				return player
			end
		end

		current =
			current.Parent
	end

	return nil
end

local function RaycastPlayer(
	position
)

	local camera =
		workspace.CurrentCamera

	if not camera then
		return nil
	end

	local ray =
		camera:ScreenPointToRay(
			position.X,
			position.Y
		)

	local params =
		RaycastParams.new()

	params.FilterType =
		Enum.RaycastFilterType.Exclude

	params.FilterDescendantsInstances = {

		LocalPlayer.Character,
	}

	params.IgnoreWater = true

	local result =
		workspace:Raycast(
			ray.Origin,
			ray.Direction * 4000,
			params
		)

	if result then

		return GetPlayerFromPart(
			result.Instance
		)
	end

	return nil
end

------------------------------------------------------------

local function FindClickedPlayer(
	position,
	touchMode
)

	local direct =
		RaycastPlayer(
			position
		)

	if direct then
		return direct
	end

	local offsets

	if touchMode then

		offsets = {

			Vector2.new(-8, 0),
			Vector2.new(8, 0),

			Vector2.new(0, -8),
			Vector2.new(0, 8),

			Vector2.new(-14, -14),
			Vector2.new(14, -14),

			Vector2.new(-14, 14),
			Vector2.new(14, 14),
		}

	else

		offsets = {

			Vector2.new(-5, 0),
			Vector2.new(5, 0),

			Vector2.new(0, -5),
			Vector2.new(0, 5),
		}
	end

	for _, offset in ipairs(offsets) do

		local player =
			RaycastPlayer(
				position + offset
			)

		if player then
			return player
		end
	end

	return nil
end

------------------------------------------------------------

local function ProcessClickTarget(
	position,
	touchMode
)

	if not CONFIG.ClickTarget then
		return
	end

	if not position then
		return
	end

	if IsOverOurGui(position) then
		return
	end

	local player =
		FindClickedPlayer(
			position,
			touchMode
		)

	if not player then
		return
	end

	if IsClickSelectable(player) then

		SelectedPlayer =
			player

		ApplyHighlight()

		UpdateTargetInfo()

		RefreshPlayerList()

		Status.Text =
			"Status: CLICK → "
			.. player.Name
	end
end


local function New(
	className,
	properties,
	parent
)

	local obj =
		Instance.new(className)

	for property, value in pairs(
		properties or {}
	) do

		obj[property] = value
	end

	obj.Parent = parent

	return obj
end

local function Corner(
	object,
	radius
)

	local c =
		Instance.new("UICorner")

	c.CornerRadius =
		UDim.new(
			0,
			radius or 6
		)

	c.Parent = object

	return c
end

local function Stroke(
	object,
	thickness
)

	local s =
		Instance.new("UIStroke")

	s.Thickness =
		thickness or 1

	s.Transparency = 0.1

	s.Parent = object

	return s
end


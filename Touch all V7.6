-- TARGET LIST
------------------------------------------------------------

local function GetTargets()

	local result = {}

	for _, player in ipairs(
		Players:GetPlayers()
	) do

		if IsValidTarget(player) then

			table.insert(
				result,
				player
			)
		end
	end

	return result
end

local function SortPlayers(list)

	table.sort(
		list,
		function(a, b)

			return string.lower(a.Name)
				<
				string.lower(b.Name)

		end
	)

	return list
end

------------------------------------------------------------
-- TELEPORT POSITION
------------------------------------------------------------

local function GetTargetCFrame(player)

	local root =
		GetRoot(player)

	if not root then
		return nil
	end

	if CONFIG.PositionMode ==
		"Front" then

		return root.CFrame *
			CFrame.new(
				0,
				0,
				-CONFIG.Distance
			)
	end

	if CONFIG.PositionMode ==
		"Back" then

		return root.CFrame *
			CFrame.new(
				0,
				0,
				CONFIG.Distance
			)
	end

	return root.CFrame
end

local function TeleportTo(player)

	if not IsValidTarget(player) then
		return false
	end

	local localRoot =
		GetRoot(LocalPlayer)

	if not localRoot then
		return false
	end

	local targetCFrame =
		GetTargetCFrame(player)

	if not targetCFrame then
		return false
	end

	localRoot.CFrame =
		targetCFrame

	LastTarget =
		player

	return true
end

------------------------------------------------------------
-- START / RETURN
------------------------------------------------------------

local function SaveStartPosition()

	local root =
		GetRoot(LocalPlayer)

	if root then

		StartCFrame =
			root.CFrame
	end
end

local function ReturnToStart()

	if not StartCFrame then
		return
	end

	local root =
		GetRoot(LocalPlayer)

	if root then

		root.CFrame =
			StartCFrame
	end
end

------------------------------------------------------------
-- DELAY
------------------------------------------------------------

local function TeleportDelay(token)

	if not Running then
		return false
	end

	if token ~= ActionToken then
		return false
	end

	local delay =
		math.clamp(
			tonumber(
				CONFIG.TeleportDelay
			) or 0,
			0,
			CONFIG.MaxDelay
		)

	if delay > 0 then

		task.wait(delay)
	end

	return
		Running
		and token == ActionToken
end

